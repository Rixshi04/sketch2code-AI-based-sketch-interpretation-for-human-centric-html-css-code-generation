# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Generation order: default = Gemini/OpenAI first, then local ML backend. Set to run OpenCV/ML before cloud APIs.
# ML_BEFORE_CLOUD=true

# Ollama — free local LLM (enabled by default). Set ENABLE_OLLAMA=false if you do not use it.
# https://ollama.com — ollama pull llama3.2 && ollama pull llava
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_VISION_MODEL=llava
# OLLAMA_USE_VISION=true

# Hugging Face Inference API — enabled when HF_API_TOKEN is set; set ENABLE_HF=false to disable
# HF_API_TOKEN=hf_xxxxxxxx
# HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# HF_MAX_NEW_TOKENS=1536

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated fallbacks if a model is unavailable in your region
# GEMINI_VISION_MODEL=gemini-2.0-flash,gemini-2.5-flash,gemini-1.5-flash

# Mistral Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter (Llama, others) Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_hf_token_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Database Configuration (SQLite - no server needed)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth Configuration (required for auth)
NEXTAUTH_URL=http://localhost:3000
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your_nextauth_secret_here

# Email Configuration (Optional)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_email_password

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=your_ga_id_here
MIXPANEL_TOKEN=your_mixpanel_token_here

# Payment Processing (Optional)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Redis Configuration (Optional - for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info

# ML Backend Configuration
# Keep these identical (same host/port) so /api/generate and ml-backend-client hit one server.
# Next.js server reads NEXT_PUBLIC_* and ML_BACKEND_URL / BACKEND_URL; see lib/ml-backend-url.ts.
BACKEND_URL=http://127.0.0.1:8000
ML_BACKEND_URL=http://127.0.0.1:8000

# Frontend-only URLs for status banners / tooling (safe to expose)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ML_BACKEND_URL=http://127.0.0.1:8000

# Python FastAPI: max seconds to wait for hybrid OpenCV pipeline before returning pipeline_timeout
PIPELINE_TIMEOUT_SECONDS=28


# Feature Flags
ENABLE_GOOGLE_AUTH=true
ENABLE_EMAIL_AUTH=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_ANALYTICS=true 
