{
  "name": "sketchmaster",
  "version": "1.0.0",
  "description": "AI-Driven Cross-Platform UI Code Generator with UX Validation and Interactive Editor",
  "main": "index.js",
  "scripts": {
    "predev": "node scripts/prisma-predev-safe.js",
    "next": "next dev",
    "ml": "python start_backend.py",
    "dev": "concurrently -k -n FRONTEND,ML -c blue,green \"npm run next\" \"npm run ml\"",
    "dev:clean": "node -e \"try{require('node:fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit --incremental false -p tsconfig.typecheck.json",
    "check-all": "npm run type-check && npm run lint",
    "pre-production": "node scripts/pre-production-check.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/setup-database.js",
    "db:setup": "node scripts/setup-database.js",
    "db:test": "node scripts/test-database.js",
    "db:verify": "node scripts/test-database.js",
    "db:migrate-mongo": "node scripts/migrate-to-mongodb.js",
    "check": "node scripts/check-setup.js",
    "check-setup": "node scripts/check_setup.js",
    "setup-db": "node scripts/setup-database-url.js",
    "db:reset": "prisma migrate reset --force",
    "verify": "npm run type-check && npm run lint && npm run build",
    "fix-auth": "node scripts/fix-auth-config.js",
    "fix": "node scripts/fix-project.js",
    "db:setup-schema": "node scripts/setup-database-schema.js",
    "fix-oauth": "node scripts/fix-oauth.js",
    "check-oauth": "node scripts/check-oauth-credentials.js",
    "add-oauth": "node scripts/add-oauth-credentials.js",
    "complete-setup": "node scripts/complete-setup.js",
    "verify:all": "npm run type-check && npm run lint && npm run db:test",
    "verify:backend": "python -c \"import fastapi, uvicorn, sqlmodel; print('Backend dependencies OK')\"",
    "verify:ml-health": "curl -f http://127.0.0.1:8000/health || echo '⚠️  ML backend not running'",
    "setup:secrets": "node scripts/generate-secrets.js",
    "setup:full": "npm install && npm run setup:secrets && npm run db:generate && npm run db:push",
    "go": "node scripts/run-all.js",
    "train:sketch": "python scripts/train_lightweight.py",
    "lockin:fix": "node scripts/lockin-fix.js",
    "lockin:quick": "node scripts/lockin-fix.js --skip-pull",
    "review:smoke": "node scripts/review-smoke.js",
    "lockin:all": "npm run lockin:quick && npm run review:smoke"
  },
  "keywords": [
    "ai",
    "ui-generator",
    "cross-platform",
    "ux-validation",
    "code-generation",
    "react",
    "vue",
    "angular",
    "flutter",
    "swiftui"
  ],
  "author": "SketchMaster Team",
  "license": "MIT",
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.0.0",
    "critters": "^0.0.20",
    "dotenv": "^17.2.3",
    "firebase": "^12.0.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.23.6",
    "google-auth-library": "^10.2.1",
    "lucide-react": "^0.292.0",
    "monaco-editor": "^0.44.0",
    "multer": "^2.0.1",
    "next": "^14.0.0",
    "next-auth": "^5.0.0-beta.29",
    "next-connect": "^1.0.0",
    "openai": "^5.23.2",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-live": "^4.1.8",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "prisma": "^5.22.0"
  },
  "directories": {
    "lib": "lib"
  },
  "type": "commonjs"
}
